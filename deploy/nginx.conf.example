# nginx server blocks for ebhq.dev, serving the output of `npm run build` (dist/).
# Copy dist/ to /var/www/ebhq/dist, adjust the paths, then test with `nginx -t`.
#
# The Content-Security-Policy below is the one in scripts/csp.cjs
# (buildCsp({ forHeader: true })); tests/security.test.cjs fails if they differ.
# If you build with an endpoint for submissions, use that variant of the policy instead:
#   node -e "console.log(require('./scripts/csp.cjs').buildCsp({forHeader:true,endpoint:'https://...'}))"

server {
    listen 80;
    listen [::]:80;
    server_name ebhq.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ebhq.dev;

    # Certificates from Let's Encrypt (for example via certbot); renew automatically.
    ssl_certificate     /etc/letsencrypt/live/ebhq.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ebhq.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/ebhq/dist;
    index index.html;
    autoindex off;
    server_tokens off;

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Security headers. `always` keeps them on error pages too.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Only GET and HEAD make sense for a static site.
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }

    # Never serve dotfiles (.git, .env, .htaccess ...).
    location ~ /\. { return 404; }

    # The page itself: always revalidate so a deploy shows up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        # add_header in a location replaces the server-level ones, so repeat them.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
    }

    location / {
        try_files $uri =404;
    }
}
