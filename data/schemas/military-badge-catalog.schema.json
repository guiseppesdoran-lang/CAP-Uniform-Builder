{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAP Uniform Builder U.S. military badge catalog",
  "type": "object",
  "required": ["schemaVersion", "badges"],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "officialName", "family", "authorizedServices", "status", "representations", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "officialName": {"type": "string", "minLength": 1},
          "family": {"enum": ["AVIATION", "AIRCREW", "SPACE", "CYBER", "MISSILE", "EOD", "DIVER", "MEDICAL", "CHAPLAIN", "COMBAT", "QUALIFICATION", "COMMAND", "IDENTIFICATION", "FOREIGN", "OTHER"]},
          "authorizedServices": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["CURRENT", "HISTORICAL", "OBSOLETE_BUT_WEARABLE", "UNKNOWN"]},
          "variants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "representations": {"type": "object"},
          "sources": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
